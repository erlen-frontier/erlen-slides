#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo 'Checking Node.js and npm...'
node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 12)) throw new Error("Tabula requires Node.js 22.12.0 or newer")'
npm --version

echo 'Installing locked npm dependencies...'
if [[ -d node_modules ]]; then
  # npm install checks the lockfile without deleting the restored dependency tree.
  time npm install --prefer-offline --no-audit --no-fund
else
  time npm ci --no-audit --no-fund
fi

echo 'Checking Chromium for Playwright and MCP previews...'
if [[ ! -x "$(node -e 'import("playwright-core").then(({default: pw}) => process.stdout.write(pw.chromium.executablePath()))')" ]]; then
  time npx --no-install playwright-core install --with-deps chromium
fi

echo 'Building the local editor...'
time npm run build
