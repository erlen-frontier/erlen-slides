    {
      "id": "example-derivacion-7",
      "layout": "content",
      "title": "Mostrar la evidencia",
      "blocks": [
        {
          "id": "example-derivacion-8",
          "type": "math",
          "tex": "c(t)=c_0e^{-kt}",
          "size": "n",
          "derivacion": true,
          "pasos": [
            {
              "tex": "\\frac{dc}{dt}=-kc",
              "nota": "Hipótesis: k constante."
            },
            {
              "tex": "\\int_{c_0}^{c(t)}\\frac{dc}{c}=-\\int_0^t k\\,dt",
              "nota": "Separación de variables."
            },
            {
              "tex": "\\ln\\frac{c(t)}{c_0}=-kt",
              "nota": "Integración para c positivo."
            },
            {
              "tex": "c(t)=c_0e^{-kt}",
              "nota": "Solución con condición inicial."
            }
          ]
        }
      ],
      "notes": "Datos o modelos didácticos: reemplazar antes de presentar resultados propios.",
      "min": 1.5
    },
