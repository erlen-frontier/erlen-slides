{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabula",
  "mainBinaryName": "tabula",
  "version": "../package.json",
  "identifier": "com.erlen.slides",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "create": false, "title": "Tabula", "width": 1440, "height": 900, "minWidth": 380, "minHeight": 480}],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https: http:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://api.crossref.org https://api.zotero.org http://127.0.0.1:*; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "licenseFile": "../LICENSE",
    "resources": {"../LICENSE": "LICENSE", "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md", "../licenses/": "licenses/"},
    "category": "Education",
    "linux": {"deb": {"depends": ["xdg-utils"]}},
    "shortDescription": "Presentaciones científicas locales",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
